[Unit]
Description=Pi 3 Video Kiosk (Ultra-Optimized Pendrive Auto-Player)
After=sound.target local-fs.target systemd-udevd.service
Wants=sound.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pi3-video-kiosk/player.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

