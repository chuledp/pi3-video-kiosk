[Unit]
Description=Pi 3 Video Kiosk (Headless Ultra-Optimized Pendrive Player)
After=sound.target local-fs.target systemd-udevd.service
Wants=sound.target
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pi3-video-kiosk/player.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target

